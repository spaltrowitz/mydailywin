rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles collection - stores admin relationships
    match /profiles/{profileId} {
      // Anyone authenticated can read profile metadata
      allow read: if request.auth != null;
      
      // Only the profile owner can create/update the profile itself
      allow write: if request.auth != null;
      
      // Admins subcollection
      match /admins/{adminEmail} {
        // Authenticated users can read admins list
        allow read: if request.auth != null;
        
        // Allow creating new admins if authenticated
        allow create: if request.auth != null;
        
        // Allow updates (like marking as accepted) if the user's email matches
        allow update: if request.auth != null && 
          (request.auth.token.email == adminEmail || 
           resource.data.addedBy == request.auth.token.email);
        
        // Allow delete by the person who added them or themselves
        allow delete: if request.auth != null;
      }
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        // Admins can read notifications for this profile
        allow read: if request.auth != null;
        
        // Anyone authenticated can create notifications (for invite acceptance)
        allow create: if request.auth != null;
        
        // Allow marking as read
        allow update: if request.auth != null;
        
        // Allow delete
        allow delete: if request.auth != null;
      }
    }
    
    // Payout requests collection - syncs across devices
    match /payoutRequests/{requestId} {
      // Users can read their own payout requests (requestId should contain profileId)
      // Admins need to read all requests for their profiles
      allow read: if request.auth != null;
      
      // Only authenticated users can create payout requests
      allow create: if request.auth != null;
      
      // Only authenticated users can update status (for admin approval)
      allow update: if request.auth != null;
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
    
    // User notifications collection - for payment confirmations etc
    match /userNotifications/{notificationId} {
      // Only authenticated users can read notifications
      allow read: if request.auth != null;
      
      // Only authenticated users can create notifications
      allow create: if request.auth != null;
      
      // Only authenticated users can update (mark as read)
      allow update: if request.auth != null;
      
      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
    
    // User state collection - syncs habit data across devices
    match /userState/{profileId} {
      // Only authenticated users can read/write their own state
      // The profileId should match a profile they have access to
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Task proposals collection - user suggestions for new tasks
    match /taskProposals/{proposalId} {
      // Admins can read all proposals
      allow read: if request.auth != null;
      
      // Anyone can create a proposal (even anonymous for now)
      allow create: if true;
      
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }
  }
}
