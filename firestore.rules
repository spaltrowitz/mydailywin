rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Ownership helpers
    //
    // These check the Firestore profiles collection for ownership data.
    // isProfileOwner: ownerEmail on the profile doc matches the caller.
    // isProfileAdmin: caller's email exists in the admins subcollection.
    //
    // LIMITATION: Profile docs are currently created in localStorage
    // by get-started.html, NOT in Firestore. Until a Firestore-first
    // profile creation flow is added, isProfileOwner() returns false
    // for profiles that have no Firestore doc. isProfileAdmin() still
    // works when the admins subcollection has been populated.
    // ================================================================

    function isProfileOwner(profileId) {
      // Guard: if the profile doc doesn't exist yet (created in localStorage,
      // not Firestore), return false instead of throwing a permission error.
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        && request.auth.token.email ==
          get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerEmail;
    }

    function isProfileAdmin(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId)/admins/$(request.auth.token.email));
    }

    function hasProfileAccess(profileId) {
      return isProfileOwner(profileId) || isProfileAdmin(profileId);
    }

    // ================================================================
    // Profiles collection
    // ================================================================
    match /profiles/{profileId} {
      // Any auth user can read profile metadata.
      // Required for the auth flow: admin.html reads the profile doc
      // to check ownerEmail before granting dashboard access.
      allow read: if request.auth != null;

      // Creator must set ownerEmail to their own email
      allow create: if request.auth != null
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail == request.auth.token.email;

      // Only the owner or a listed admin can update
      allow update: if request.auth != null
        && hasProfileAccess(profileId);

      // Only the owner can delete
      allow delete: if request.auth != null
        && isProfileOwner(profileId);

      // ----- Admins subcollection -----
      match /admins/{adminEmail} {
        // Self-read (admin checking own invite status) or profile owner/admin
        allow read: if request.auth != null
          && (request.auth.token.email == adminEmail
              || hasProfileAccess(profileId));

        // Profile owner or existing admins can invite new admins.
        // Also allow the profile owner to bootstrap the first admin entry
        // (before any admins exist in the subcollection).
        allow create: if request.auth != null
          && request.resource.data.email is string
          && (hasProfileAccess(profileId)
              || isProfileOwner(profileId));

        // Admin can update own record (e.g. acceptedAt), owner/admin can update any
        allow update: if request.auth != null
          && (request.auth.token.email == adminEmail
              || hasProfileAccess(profileId));

        // Only profile owner or existing admins can remove
        allow delete: if request.auth != null
          && hasProfileAccess(profileId);
      }

      // ----- Notifications subcollection (admin-facing) -----
      match /notifications/{notificationId} {
        // Only profile owner or admins can read
        allow read: if request.auth != null
          && hasProfileAccess(profileId);

        // Any auth user can create (for invite-acceptance notifications)
        allow create: if request.auth != null
          && request.resource.data.type is string;

        // Only profile owner or admins can update/delete
        allow update, delete: if request.auth != null
          && hasProfileAccess(profileId);
      }
    }

    // ================================================================
    // Payout requests — cross-device sync
    //
    // Scoped by profile ownership: only the profile owner or a listed
    // admin can access payout requests for that profile.
    // ================================================================
    match /payoutRequests/{requestId} {
      allow read: if request.auth != null
        && hasProfileAccess(resource.data.profileId);

      allow create: if request.auth != null
        && request.resource.data.profileId is string
        && request.resource.data.amount is number
        && request.resource.data.status == 'pending'
        && hasProfileAccess(request.resource.data.profileId);

      allow update: if request.auth != null
        && request.resource.data.profileId is string
        && hasProfileAccess(resource.data.profileId);

      allow delete: if request.auth != null
        && hasProfileAccess(resource.data.profileId);
    }

    // ================================================================
    // User notifications (user-facing — payment confirmations etc.)
    //
    // Scoped by profile ownership: only the profile owner or a listed
    // admin can access notifications for that profile.
    // ================================================================
    match /userNotifications/{notificationId} {
      allow read: if request.auth != null
        && hasProfileAccess(resource.data.profileId);

      allow create: if request.auth != null
        && request.resource.data.profileId is string
        && request.resource.data.type is string
        && request.resource.data.read == false
        && hasProfileAccess(request.resource.data.profileId);

      allow update: if request.auth != null
        && hasProfileAccess(resource.data.profileId);

      allow delete: if request.auth != null
        && hasProfileAccess(resource.data.profileId);
    }

    // ================================================================
    // User state — habit data sync across devices
    //
    // Scoped by profile ownership: the doc ID is the profileId, so
    // only the profile owner or a listed admin can read/write.
    // Legacy "stu" profile allows any authenticated user (including
    // anonymous auth) to write, enabling sync without sign-in.
    // ================================================================
    match /userState/{profileId} {
      allow read: if request.auth != null
        && (hasProfileAccess(profileId) || profileId == 'stu');
      allow write: if request.auth != null
        && (hasProfileAccess(profileId) || profileId == 'stu');
    }

    // ================================================================
    // Task proposals — user suggestions for new tasks
    //
    // Scoped by profile ownership: only the profile owner or a listed
    // admin can read/update/delete proposals for that profile.
    // ================================================================
    match /taskProposals/{proposalId} {
      allow read: if request.auth != null
        && hasProfileAccess(resource.data.profileId);

      allow create: if request.auth != null
        && request.resource.data.profileId is string
        && request.resource.data.taskName is string
        && request.resource.data.status == 'pending'
        && hasProfileAccess(request.resource.data.profileId);

      allow update, delete: if request.auth != null
        && hasProfileAccess(resource.data.profileId);
    }
  }
}
